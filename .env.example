# Copy this file to .env, then enter your own Groq key locally.
# Never put a real API key in this example file or in frontend code.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Auth only. Use the Project URL and publishable/anon key, never a secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Local prototype limits. These are enforced by FastAPI and stored in SQLite when stateful.
MAX_COURSES_PER_USER=3
MAX_DOCUMENTS_PER_COURSE=5
MAX_PDF_BYTES=5242880
MAX_AI_QUESTIONS_PER_DAY=10
# For local testing only, explicitly set the same setting to 30 in your local .env.
# Counts unique model-attempting requests per authenticated student per UTC day.
# A failed request's same-ID retry does not charge again; no usage rows are reset.
# One active credential, selected manually by an administrator. Never rotate on 429.
GROQ_CREDENTIAL=primary
# GROQ_REPLACEMENT_API_KEY=optional_legitimate_replacement_key
MAX_CONCURRENT_PROCESSING=2

# Exact HTTPS frontend origins, comma-separated; no wildcard. Local Vite remains allowed.
CORS_ALLOWED_ORIGINS=
# Set only to durable storage on a future host; never assume container disk persists.
# KNOWLEDGEPILOT_STORAGE_PATH=/durable/knowledgepilot
