# Copy this to .env.local in this folder and paste the Supabase Project URL and publishable/anon key.
# These are public client settings; never place a service_role or secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Optional: FastAPI address. Local backend default is port 8001.
VITE_API_URL=http://127.0.0.1:8001
